PORT=3000
CORS_ORIGIN=*

# --- Persistence (optional) ---
# Without DATABASE_URL the app runs entirely in memory: recording works,
# but nothing is saved and sign-in is disabled.
DATABASE_URL=postgres://user:pass@host:5432/topper
# TLS is auto-detected: off for localhost, on for anything else.
# Override with "disable" or "require" only if that guess is wrong.
PGSSL=

# --- Google sign-in (optional; requires DATABASE_URL) ---
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# and add your origin to "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=
# Any long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=
